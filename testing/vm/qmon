#!/usr/bin/env python3
"""Send commands to the VM's QEMU monitor: screendump, sendkey, and so on."""
import os
import socket
import sys
import time

HERE = os.path.join(os.path.dirname(os.path.abspath(__file__)), "run")

s = socket.socket(socket.AF_UNIX)
s.connect(os.path.join(HERE, "monitor.sock"))
s.settimeout(2)
time.sleep(0.2)
try:
    s.recv(65536)
except Exception:
    pass
for cmd in sys.argv[1:]:
    s.sendall((cmd + "\n").encode())
    time.sleep(0.25)
    try:
        s.recv(65536)
    except Exception:
        pass
time.sleep(0.5)
