description "caelestia shell and the look that goes with it"
needs "gui"

// AUR packages are not separated out: lami reads pacman's sync database to
// tell where a package comes from, so you need not keep track of it.
packages {
    adw-gtk-theme
    papirus-icon-theme

    caelestia-shell             // from the AUR
    caelestia-cli
    bibata-cursor-theme-bin
}
