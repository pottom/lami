description "A working Hyprland desktop"
needs "core"

packages {
    hyprland
    uwsm
    greetd
    greetd-regreet
    ghostty
    thunar
    firefox     // needed for work SSO, do not swap for chromium
}

services {
    greetd
    power-profiles-daemon    // hard dependency of caelestia-shell
}

// The GPU-dependent part. Same layer everywhere, different driver.
when gpu="intel" {
    packages { mesa; intel-media-driver; vulkan-intel }
}

when gpu="nvidia" {
    // As of 2026 the plain "nvidia" package no longer exists in the Arch
    // repositories, and Blackwell (RTX 50xx) requires the open modules.
    packages { nvidia-open; nvidia-utils; egl-wayland }
}

when gpu="amd" {
    packages { mesa; vulkan-radeon; libva-mesa-driver }
}

// Only where there is an external monitor speaking DDC/CI.
when ddc=on {
    packages { ddcutil }
}

// On a laptop the internal panel backlight works differently.
when class="laptop" {
    packages { brightnessctl }
}

// The VA-API driver name differs per GPU, so the file is declared inside the
// matching `when` block rather than templated with a lookup table. Only one
// of these can apply to a given host.
when gpu="intel" {
    file "/etc/environment.d/50-gpu.conf" {
        text """
        # Managed by lami.
        LIBVA_DRIVER_NAME=iHD
        """
    }
}

when gpu="nvidia" {
    file "/etc/environment.d/50-gpu.conf" {
        text """
        # Managed by lami.
        LIBVA_DRIVER_NAME=nvidia
        """
    }
}
