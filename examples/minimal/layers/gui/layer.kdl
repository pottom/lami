description "Működő Hyprland asztal"
needs "core"

packages {
    hyprland
    uwsm
    greetd
    greetd-regreet
    ghostty
    thunar
    firefox     // a munkahelyi SSO miatt kell, ne cseréld chromiumra
}

services "greetd" "power-profiles-daemon"

// A GPU-tól függő rész. Ugyanaz a réteg, más driver.
when gpu="intel" {
    packages { mesa; intel-media-driver; vulkan-intel }
}

when gpu="nvidia" {
    // 2026: a sima "nvidia" csomag már nem létezik az Arch repókban,
    // Blackwell (RTX 50xx) esetén az open modul kötelező.
    packages { nvidia-open; nvidia-utils; egl-wayland }
}

when gpu="amd" {
    packages { mesa; vulkan-radeon; libva-mesa-driver }
}

// Csak akkor, ha van külső monitor DDC/CI-vel.
when ddc=on {
    packages { ddcutil }
}

// Laptopon a belső panel fényereje máshogy megy.
when class="laptop" {
    packages { brightnessctl }
}
