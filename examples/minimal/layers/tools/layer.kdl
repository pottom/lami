description "Command line tools"
needs "core"

packages {
    fish
    starship
    bat
    eza
    btop
    ripgrep
    rsync       // lami's own capture uses this to copy files
}

services {
    bluetooth
}

// A script under ~/.local/bin is meant to be run, so it is made executable
// without saying so.
file "~/.local/bin/hello" {
    text """
    #!/usr/bin/env bash
    echo "hello from {{ hostname }}"
    """
}
