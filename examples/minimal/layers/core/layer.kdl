description "Base system: boot, filesystem, network"

packages {
    base
    base-devel
    linux
    linux-firmware
    btrfs-progs
    networkmanager
    sudo
    git
}

services {
    NetworkManager
    sshd
    fstrim.timer
}

when ucode="intel" {
    packages { intel-ucode }
}

when ucode="amd" {
    packages { amd-ucode }
}

// A whole file taken verbatim from the layer directory.
file "/etc/pacman.conf" from="files/pacman.conf"

// Inline content, templated. The triple-quoted string dedents automatically,
// so the indentation that keeps this config readable does not end up in the
// rendered file.
file "/etc/makepkg.conf.d/99-local.conf" {
    text """
    #!/hint/bash
    # Managed by lami -- a drop-in, so the package-owned /etc/makepkg.conf
    # stays untouched and never produces a .pacnew.

    MAKEFLAGS="-j{{ cpu_threads }}"

    # The Arch default. Higher zstd levels cost hundreds of MB per thread and
    # are orders of magnitude slower, for a package you unpack once.
    COMPRESSZST=(zstd -c -T0 -)
    """
}

file "/etc/hostname" {
    text "{{ hostname }}"
}

// sudo silently ignores a drop-in whose mode is not exactly 0440 -- so lami
// infers that from the path and you do not have to remember it.
file "/etc/sudoers.d/10-wheel" {
    text "%wheel ALL=(ALL:ALL) NOPASSWD: ALL"
}

// 0640 is not something any path rule could guess, so it is stated outright.
// Modes are written as strings: a bare 0640 would be read as decimal.
file "/etc/snapper/configs/root" from="files/snapper-root" mode="0640"

file "/etc/mkinitcpio.conf" from="files/mkinitcpio.conf"

// Changing the initramfs config is not enough on its own; it has to be
// regenerated. mkinitcpio -P is idempotent, so re-running it is harmless.
on-change "/etc/mkinitcpio.conf" {
    run "mkinitcpio -P"
}
