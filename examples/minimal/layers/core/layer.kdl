description "Base system: boot, filesystem, network"

packages {
    base
    base-devel
    linux
    linux-firmware
    btrfs-progs
    networkmanager
    sudo
    git
}

services {
    NetworkManager
    sshd
    fstrim.timer
}

when ucode="intel" {
    packages { intel-ucode }
}

when ucode="amd" {
    packages { amd-ucode }
}
