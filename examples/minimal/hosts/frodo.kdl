description "Desktop, Gigabyte Z390 + i7-9700K"

// The layers this host gets. Their dependencies (`needs`) are added
// automatically -- no need to list them here.
layers "core" "tools" "gui" "rice"

// Parameters. The `when` blocks in layers refer to these.
gpu   "intel"
ucode "intel"
class "desktop"

cpu_threads 8
ddc   on            // external monitor brightness over DDC/CI
